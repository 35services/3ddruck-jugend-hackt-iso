# jugendhackt-iso config file
#
# This file configures the adjustments to the bootstraped live environment

# the Ubuntu release codename to use for bootstrap
RELEASE_BASE="mantic"

# the Ubuntu archive mirror to use for bootstrap. Does not affect running system
RELEASE_MIRROR="http://archive.ubuntu.com/ubuntu"

# the locale config. Supports de_AT for our beloved Jh Linz event <3 ^^
LANGUAGE="de_DE"

# the keyboard language to use
KEYBOARD_LAYOUT="de"

# the two-letter language code used for language pack installations, e.g. fr for language-pack-fr
# Proudly introduced for Jh Zurich event <3
LANGUAGE_PACK="de"

# additional APT repositories to enable
ADDITIONAL_REPOSITORIES="ppa:mozillateam/ppa ppa:oibaf/graphics-drivers ppa:canonical-kernel-team/proposed"

# additional APT packages to install
ADDITIONAL_PACKAGES="git vim nano firefox godot3 gimp android-sdk android-sdk nodejs npm vlc"

# additional Flatpak packages to include. Must be available on Flathub as of now
ADDITIONAL_FLATPAKS="cc.arduino.IDE2 com.jetbrains.IntelliJ-IDEA-Community com.vscodium.codium edu.mit.Scratch com.tic80.TIC_80 org.processing.processingide org.fritzing.Fritzing org.zulip.Zulip org.inkscape.Inkscape org.chromium.Chromium"

# your chance to remove bloatware like snapd or apport
PACKAGE_REMOVAL="snapd apport"
