# jugendhackt-iso config file
#
# This file configures the adjustments to the bootstraped live environment

# the Debian release codename to use for bootstrap
RELEASE_BASE="sid"

# the Debian archive mirror to use for bootstrap. Does not affect running system
RELEASE_MIRROR="https://deb.debian.org/debian"

# the language tasks used for localization, e.g. french for task-french
TASK_LANGUAGES="arabic czech croatian english french german hungarian italian polish russian serbian turkish ukrainian"

# additional APT packages to install
ADDITIONAL_PACKAGES="git vim nano webext-ublock-origin-firefox gimp inkscape krita openscad freecad nodejs npm vlc docker.io docker-compose docker-buildx"

# additional Flatpak packages to include. Must be available on Flathub as of now
ADDITIONAL_FLATPAKS="cc.arduino.IDE2 com.vscodium.codium edu.mit.Scratch org.processing.processingide io.github.ungoogled_software.ungoogled_chromium com.prusa3d.PrusaSlicer com.ultimaker.cura"

# additional Flatpak bundles (.flatpak files) to download and install, for apps not on Flathub.
# Must be built for x86_64. Bundles do not auto-update, bump the URLs to update
ADDITIONAL_FLATPAK_BUNDLES="https://github.com/Snapmaker/OrcaSlicer/releases/download/v2.4.0/Snapmaker_Orca-Linux-flatpak_V2.4.0_x86_64.flatpak"

# Inkscape extensions (.zip archives) to install into the live user's Inkscape extensions directory
# requires inkscape in ADDITIONAL_PACKAGES. Default: AxiDraw plotter extension, https://wiki.evilmadscientist.com/Axidraw_Software_Installation
INKSCAPE_EXTENSION_ZIPS="https://cdn.evilmadscientist.com/dl/ad/public/395/AxiDraw_395_LinX86.zip"

DEBCONF_SELECTIONS=(
    "ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true"
    # https://bugs-devel.debian.org/cgi-bin/bugreport.cgi?bug=856594
    "kdump-tools kdump-tools/use_kdump select false"
)

# public SSH keys allowed to log in as the live user. If set, openssh-server is installed and
# password logins via SSH are disabled. Leave empty to not install an SSH server
SSH_AUTHORIZED_KEYS=(
    "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOSeMYYS42X+Q3rVv6souuzIvPc2lvrvBetwd2CBn7B6 falkorichter@MacBook-Pro.fritz.box"
)

# your chance to remove bloatware you don't want to have installed
PACKAGE_REMOVAL=""
