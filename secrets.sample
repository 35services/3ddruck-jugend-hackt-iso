# Logins that must never be committed. Copy this file to ./secrets
# (ignored by git) and fill in the values. Read by jugendhackt-iso.sh and
# ansible/desktop-files.yml. Use plain KEY=value lines.

# login for the AG's Snapmaker account, put on the desktop as snapmaker-konto.txt
SNAPMAKER_USERNAME=
SNAPMAKER_PASSWORD=

# login for the AG's MakerWorld account, put on the desktop as makerworld-konto.txt
MAKERWORLD_USERNAME=
MAKERWORLD_PASSWORD=

# Tailscale auth key for ansible/tailscale.yml, from the admin console (Settings > Keys).
# Make it reusable to log in several machines with it.
TAILSCALE_AUTHKEY=
